<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset Password | Nigeria Pry & Sec Result Vault</title>
    <style>
        body { background: #f8fafc; margin: 0; font-family: sans-serif; color: #1e293b; display: flex; flex-direction: column; min-height: 100vh; }
        .navbar { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 1.1rem; font-weight: 900; color: #1e3a8a; text-decoration: none; text-transform: uppercase; }
        .box { max-width: 440px; width: 92%; margin: 3rem auto; background: #fff; padding: 2rem; border-radius: 1rem; border: 1px solid #e2e8f0; box-shadow: 0 4px 14px rgba(0,0,0,0.05); }
        label { display: block; font-weight: bold; margin-bottom: 0.35rem; font-size: 0.9rem; }
        input { width: 100%; padding: 0.75rem; margin-bottom: 1rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; box-sizing: border-box; font-size: 0.95rem; }
        .btn { width: 100%; background: #1e3a8a; color: #fff; border: none; padding: 0.85rem; border-radius: 0.5rem; font-weight: bold; font-size: 1rem; cursor: pointer; }
        .alert-err { background: #fee2e2; color: #991b1b; padding: 0.85rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.9rem; font-weight: bold; }
        .alert-ok { background: #d1fae5; color: #065f46; padding: 0.85rem; border-radius: 0.5rem; margin-bottom: 1rem; font-size: 0.9rem; font-weight: bold; }
    </style>
</head>
<body>
    <nav class="navbar">
        <a href="/" class="logo">Nigeria Pry &amp; Sec Result Vault</a>
        <a href="/login" style="color:#1e3a8a;font-weight:bold;text-decoration:none;">Back to Log In</a>
    </nav>
    <div class="box">
        <h2 style="margin-top:0;color:#1e3a8a;">🔑 Reset Forgotten Password</h2>
        <p style="color:#64748b;font-size:0.9rem;margin-top:0;margin-bottom:1.25rem;">Enter your registered email address and last name to verify your account and create a new password.</p>
        <% if (typeof error !== 'undefined' && error) { %>
            <div class="alert-err"><%= error %></div>
        <% } %>
        <% if (typeof success !== 'undefined' && success) { %>
            <div class="alert-ok"><%= success %> — <a href="/login" style="color:#065f46;text-decoration:underline;">Click here to Log In</a></div>
        <% } %>
        <form action="/forgot-password" method="POST">
            <label>Registered Email Address</label>
            <input type="email" name="email" placeholder="e.g. student@gmail.com" required>
            <label>Registered Last Name (Surname)</label>
            <input type="text" name="lastName" placeholder="e.g. Ojo" required>
            <label>New Password</label>
            <input type="password" name="newPassword" placeholder="Enter new password (min 4 characters)" minlength="4" required>
            <button type="submit" class="btn">Reset Password Now</button>
        </form>
        <div style="margin-top:1.25rem;padding-top:1rem;border-top:1px solid #e2e8f0;text-align:center;font-size:0.88rem;color:#64748b;">
            Can't remember your email? <a href="https://wa.me" target="_blank" style="color:#16a34a;font-weight:bold;text-decoration:none;">Chat with Support on WhatsApp</a>
        </div>
    </div>
</body>
</html>
