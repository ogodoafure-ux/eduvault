<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nigeria School Result Vault | Log In</title>
    <style>
        body { background-color: #f3f4f6; font-family: sans-serif; display: flex; align-items: center; justify-content: center; height: 100vh; margin: 0; }
        .login-card { background: white; padding: 2rem; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 100%; max-width: 400px; border: 1px solid #e5e7eb; }
        .logo { font-size: 1.5rem; font-weight: 900; color: #2563eb; text-align: center; margin-bottom: 1.5rem; text-transform: uppercase; }
        .logo-span { color: #10b981; }
        .form-group { margin-bottom: 1rem; }
        label { display: block; font-size: 0.875rem; font-weight: 600; color: #374151; margin-bottom: 0.25rem; }
        input { width: 100%; padding: 0.6rem; border: 1px solid #cbd5e1; border-radius: 0.5rem; box-sizing: border-box; font-size: 0.9rem; }
        .btn { background: #10b981; color: white; border: none; width: 100%; padding: 0.75rem; border-radius: 0.5rem; font-weight: bold; font-size: 1rem; cursor: pointer; margin-top: 1rem; }
        .btn:hover { background: #059669; }
        .link { text-align: center; font-size: 0.85rem; margin-top: 1rem; color: #6b7280; }
        .link a { color: #2563eb; text-decoration: none; font-weight: bold; }
    </style>
</head>
<body>

    <div class="login-card">
        <div class="logo">Result <span class="logo-span">Vault</span></div>
        <h3 style="margin-top: 0; text-align: center; color: #111827;">Student Log In</h3>
        
        <form action="/login" method="POST">
            <div class="form-group">
                <label>Email Address</label>
                <input type="email" name="email" required placeholder="student@example.com">
            </div>
            <div class="form-group">
                <label>Password</label>
                <input type="password" name="password" required placeholder="••••••••">
            </div>
            <button type="submit" class="btn">Access Vault</button>
        </form>

        <div class="link">
            New student? <a href="/register">Create Account</a>
        </div>
    </div>

</body>
</html>
