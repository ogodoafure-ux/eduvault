        { firstName: "David", school: "Gloryland International Secondary School, Sapele" },
        { firstName: "Zainab", school: "Command Day Secondary School, Abuja" }
    ];
    var items = (Array.isArray(dbItems) && dbItems.length >= 3) ? dbItems : (Array.isArray(dbItems) ? dbItems.concat(starterItems) : starterItems);
    var i = 0;
    var textEl = document.getElementById("liveVaultText");
    var boxEl = document.getElementById("liveVaultTicker");
    if (!textEl || !boxEl || !items.length) return;
    setInterval(function() {
        i = (i + 1) % items.length;
        boxEl.style.opacity = "0";
        setTimeout(function() {
            var cur = items[i];
            var safeName = String(cur.firstName || "Student").replace(/[<>&]/g, "");
