            <p style="margin: 0 auto; max-width: 760px; font-size: 1.15rem; line-height: 1.5;">
                <strong>Every verified vault subscription automatically qualifies your child for our End-of-Year Educational Grant, featuring multiple cash and digital device awards across Primary, Junior, and Senior Secondary levels!</strong>
            </p>
            <div class="prize-grid">
                <div class="prize-item">
                    <h4>💰 ₦200,000 – ₦5,000,000 Cash Grants</h4>
                    <p>Direct tuition and educational support funds awarded to selected students across all school levels at year-end.</p>
                </div>
                <div class="prize-item">
                    <h4>💻 Laptops & Digital Learning Devices</h4>
                    <p>Brand-new Laptops, Tablets, and Smartphones to empower your child's digital education.</p>
                </div>
            </div>
        </div>

                <% if (typeof winners !== 'undefined' && winners.length > 0) { %>
        <div style="background:#ffffff;border:2px solid #f59e0b;border-radius:1.25rem;padding:2rem;margin-bottom:3rem;box-shadow:0 10px 25px -5px rgba(245,158,11,0.15);">
            <div style="text-align:center;margin-bottom:1.5rem;">
                <span style="background:#fef3c7;color:#92400e;font-weight:900;font-size:0.8rem;padding:0.35rem 0.9rem;border-radius:999px;text-transform:uppercase;">🏆 Official Grant Announcement</span>
