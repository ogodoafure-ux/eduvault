<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Nigeria Pry & Sec Result Vault & Scholarship Portal</title>
    <style>
        body { margin: 0; font-family: sans-serif; background-color: #f8fafc; color: #1e293b; }
        .navbar { background-color: #ffffff; border-bottom: 1px solid #e2e8f0; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; position: sticky; top: 0; z-index: 50; }
        .logo { font-size: 1.25rem; font-weight: 900; color: #1e3a8a; text-decoration: none; text-transform: uppercase; }
        .logo span { color: #10b981; }
        .nav-links a { text-decoration: none; font-weight: bold; margin-left: 1rem; font-size: 0.9rem; }
        .btn-login { color: #2563eb; }
        .btn-reg { background-color: #10b981; color: white; padding: 0.55rem 1.1rem; border-radius: 0.5rem; }
        .container { max-width: 1100px; margin: 2.5rem auto; padding: 0 1.5rem; }
        .hero-split { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 2.5rem; align-items: center; margin-bottom: 3rem; }
        @media(max-width: 820px) { .hero-split { grid-template-columns: 1fr; text-align: center; } }
        h1 { font-size: 2.35rem; color: #0f172a; margin: 0 0 1rem 0; line-height: 1.2; }
        p.subtitle { font-size: 1.05rem; color: #475569; margin-bottom: 1.75rem; line-height: 1.6; }
        .cta-btn { background-color: #ea580c; color: white; padding: 1rem 2rem; font-size: 1.05rem; font-weight: bold; text-decoration: none; border-radius: 0.75rem; display: inline-block; box-shadow: 0 4px 6px rgba(234, 88, 12, 0.25); }
        .cta-btn:hover { background-color: #c2410c; }
        .hero-img-box { text-align: center; }
        .hero-img-box img { width: 100%; max-width: 340px; border-radius: 1.25rem; box-shadow: 0 15px 30px -10px rgba(15, 23, 42, 0.2); border: 4px solid #ffffff; background: linear-gradient(135deg, #dbeafe, #d1fae5); padding-top: 1rem; }
        .grant-banner { background: linear-gradient(135deg, #1e3a8a, #1d4ed8); color: white; padding: 2rem; border-radius: 1.25rem; margin-bottom: 3rem; box-shadow: 0 10px 25px -5px rgba(30, 58, 138, 0.25); text-align: center; }
        .grant-badge { background-color: #f59e0b; color: #0f172a; font-weight: 900; font-size: 0.8rem; padding: 0.35rem 0.9rem; border-radius: 999px; text-transform: uppercase; display: inline-block; margin-bottom: 1rem; letter-spacing: 0.5px; }
        .prize-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem; margin-top: 1.5rem; text-align: left; }
        .prize-item { background: rgba(255, 255, 255, 0.12); border: 1px solid rgba(255, 255, 255, 0.25); padding: 1.2rem; border-radius: 0.75rem; }
        .prize-item h4 { margin: 0 0 0.4rem 0; color: #fde68a; font-size: 1.05rem; }
        .prize-item p { margin: 0; font-size: 0.9rem; color: #f1f5f9; line-height: 1.45; }
        .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.5rem; }
        .feature-card { background: white; padding: 1.5rem; border-radius: 0.75rem; border: 1px solid #e2e8f0; }
        .feature-card h3 { margin-top: 0; color: #1e3a8a; font-size: 1.1rem; }
    </style>
