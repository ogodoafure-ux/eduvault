                    <div style="font-size:0.8rem;color:#64748b;margin-bottom:0.5rem;"><%= w.level %> • <%= w.state %></div>
                    <div style="background:#10b981;color:white;display:inline-block;padding:0.25rem 0.65rem;border-radius:0.4rem;font-size:0.8rem;font-weight:bold;"><%= w.award %></div>
                </div>
                <% }) %>
            </div>
        </div>
        <% } %>
        <div class="features">
            <div class="feature-card">
                <h3>📁 Complete 12-Year Archive</h3>
                <p style="color: #64748b; font-size: 0.9rem;">Dedicated digital vaults for Primary 1–6, JSS 1–3, and SSS 1–3 across all three academic terms.</p>
            </div>
            <div class="feature-card">
                <h3>🏫 School Registry Access</h3>
                <p style="color: #64748b; font-size: 0.9rem;">Authorized school administrators can verify and audit student records securely from anywhere.</p>
            </div>
            <div class="feature-card">
                <h3>🏆 Automatic Grant Entry</h3>
                <p style="color: #64748b; font-size: 0.9rem;">Unlocking any term vault automatically enters your child into our annual cash and device grant selection across all school levels.</p>
            </div>
        </div>
    </div>
