<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>EduVault | Admin & Grant Portal</title>
    <style>
        body { background-color: #f3f4f6; margin: 0; font-family: sans-serif; color: #1f2937; }
        .navbar { background-color: #1e3a8a; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; color: white; }
        .logo { font-size: 1.25rem; font-weight: 900; color: #ffffff; text-decoration: none; text-transform: uppercase; }
        .logout-btn { color: #fca5a5; font-weight: 600; text-decoration: none; font-size: 0.875rem; }
        .container { max-width: 1200px; margin: 2rem auto; padding: 0 1rem; }
        .card { background-color: #ffffff; padding: 2rem; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.05); border: 1px solid #e5e7eb; margin-bottom: 2rem; }
        .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; align-items: end; margin-top: 1rem; }
        label { display: block; font-size: 0.8rem; font-weight: bold; color: #374151; margin-bottom: 0.3rem; }
        select { width: 100%; padding: 0.6rem; border: 1px solid #d1d5db; border-radius: 0.5rem; font-size: 0.9rem; }
        .btn-award { background-color: #f59e0b; color: #0f172a; border: none; padding: 0.65rem 1.2rem; border-radius: 0.5rem; font-weight: 900; cursor: pointer; font-size: 0.9rem; width: 100%; }
        .btn-award:hover { background-color: #d97706; color: white; }
        .btn-del { background-color: #ef4444; color: white; border: none; padding: 0.35rem 0.7rem; border-radius: 0.35rem; font-size: 0.75rem; font-weight: bold; cursor: pointer; }
        table { width: 100%; border-collapse: collapse; margin-top: 1.25rem; text-align: left; }
        th, td { padding: 0.9rem; border-bottom: 1px solid #e5e7eb; font-size: 0.9rem; }
        th { background-color: #f8fafc; color: #475569; text-transform: uppercase; font-size: 0.75rem; }
        .download-btn { background-color: #10b981; color: white; padding: 0.4rem 0.8rem; border-radius: 0.35rem; text-decoration: none; font-weight: bold; font-size: 0.75rem; display: inline-block; }
        .badge { background-color: #dbeafe; color: #1e40af; padding: 0.2rem 0.5rem; border-radius: 0.25rem; font-size: 0.75rem; font-weight: bold; }
    </style>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,%3Csvg xmlns='http://w3.org' viewBox='0 0 64 64'%3E%3Cpath d='M32 4 L56 13 V31 C56 46 45 55 32 60 C19 55 8 46 8 31 V13 Z' fill='%231e3a8a' stroke='%23eab308' stroke-width='3'/%3E%3Cpolygon points='32,17 48,24 32,31 16,24' fill='%23ffffff'/%3E%3Cpath d='M21 37 Q26.5 34 32 37.5 Q37.5 34 43 37 V46 Q37.5 43 32 46.5 Q26.5 43 21 46 Z' fill='%23eab308'/%3E%3C/svg%3E">
</head>
<body>
<% if (typeof isSuper !== 'undefined' && !isSuper && typeof schoolName !== 'undefined' && schoolName && schoolName !== 'General') { 
    const _slug = schoolName.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
    const _fullLink = 'https://nigeriapryandsecresultvaults.com' + _slug;
%>
<div style="background:#eff6ff;border:2px solid #1e3a8a;border-radius:1rem;padding:1.25rem 1.5rem;margin:1.5rem auto;max-width:1100px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.75rem;">
    <div>
        <div style="font-weight:900;color:#1e3a8a;font-size:1rem;">🔗 Your Official School Registration Link (<%= schoolName %>)</div>
        <div style="color:#334155;font-size:0.88rem;margin-top:0.2rem;">Share this link in your PTA WhatsApp group — students who register through it are automatically linked to your school!</div>
        <input type="text" id="schoolCustomLink" value="<%= _fullLink %>" readonly style="margin-top:0.5rem;width:100%;max-width:520px;padding:0.55rem 0.75rem;border:1px solid #93c5fd;border-radius:0.4rem;background:#fff;font-weight:bold;color:#1e3a8a;font-size:0.88rem;">
    </div>
    <button type="button" onclick="navigator.clipboard.writeText(document.getElementById('schoolCustomLink').value);this.innerText='✓ Link Copied!';" style="background:#16a34a;color:#fff;border:none;padding:0.75rem 1.25rem;border-radius:0.5rem;font-weight:bold;cursor:pointer;">📋 Copy School Link</button>
</div>
<% } %>
<div style='max-width:1100px;margin:1.5rem auto 0 auto;padding:0 1rem;'><% if (typeof isSuper !== 'undefined' && isSuper) { %>
<div style="background:#fff;padding:1.5rem;border-radius:1rem;border:1px solid #e2e8f0;margin-bottom:1.5rem;">
    <h2 style="margin-top:0;color:#1e3a8a;">🏫 Create Partner School Admin Account</h2>
    <p style="color:#64748b;font-size:0.9rem;">Create an isolated admin login for a school principal or registry officer. They will only see students registered under their exact School Name.</p>
    <form action="/admin/create-school-admin" method="POST" style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:0.75rem;">
        <input type="text" name="schoolName" placeholder="Exact School Name" required style="padding:0.65rem;border:1px solid #cbd5e1;border-radius:0.4rem;">
        <input type="text" name="firstName" placeholder="Principal First Name" required style="padding:0.65rem;border:1px solid #cbd5e1;border-radius:0.4rem;">
        <input type="text" name="lastName" placeholder="Principal Last Name" required style="padding:0.65rem;border:1px solid #cbd5e1;border-radius:0.4rem;">
        <input type="email" name="email" placeholder="School Admin Email" required style="padding:0.65rem;border:1px solid #cbd5e1;border-radius:0.4rem;">
        <input type="text" name="password" placeholder="Login Password" required style="padding:0.65rem;border:1px solid #cbd5e1;border-radius:0.4rem;">
        <button type="submit" style="background:#1e3a8a;color:#fff;border:none;padding:0.7rem;border-radius:0.4rem;font-weight:bold;cursor:pointer;">+ Create School Admin</button>
    </form>
    <% if (typeof schoolAdmins !== 'undefined' && schoolAdmins.length > 0) { %>
        <div style="margin-top:1rem;font-size:0.9rem;"><strong>Active School Admins:</strong>
        <% schoolAdmins.forEach(sa => { %>
            <span style="display:inline-block;background:#eff6ff;color:#1e3a8a;padding:0.3rem 0.65rem;border-radius:0.4rem;margin:0.25rem 0.35rem 0 0;"><strong><%= sa.school_name %></strong> (<%= sa.email %>) — <a href="/school/<%= sa.school_name.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '') %>" target="_blank" style="color:#16a34a;font-weight:bold;">Open School Link</a></span>
        <% }) %>
        </div>
    <% } %>
</div>
<% } %></div>
    <nav class="navbar">
        <a href="/" class="logo">EduVault <span style="color: #6ee7b7;">Admin & Grant Portal</span></a>
        <div style="display: flex; align-items: center; gap: 1.5rem;">
            <span style="font-size: 0.85rem;">Welcome, <strong><%= user.firstName %></strong></span>
            <a href="/logout" class="logout-btn">Log Out</a>
        </div>
    </nav>
    <div class="container">
        <div class="card" style="border-top: 4px solid #f59e0b;">
            <h2 style="margin-top: 0; color: #1e3a8a;">🏆 Annual Academic Grant & Tech Award Publisher</h2>
            <p style="color: #64748b; font-size: 0.875rem;">Select a student or pick one randomly. Published recipients immediately appear on the public homepage and receive a congratulations banner in their dashboard.</p>
            
            <form action="/admin/add-winner" method="POST" class="form-grid">
                <div>
                    <label>Select Student</label>
                    <select name="studentId" required>
                        <option value="RANDOM">🎲 Pick Random Student</option>
                        <% students.forEach(s => { %>
                            <option value="<%= s.id %>"><%= s.first_name %> <%= s.last_name %> (<%= s.email %>)</option>
                        <% }) %>
                    </select>
                </div>
                <div>
                    <label>School Category</label>
                    <select name="level" required>
                        <option value="Primary School Level">Primary School Level</option>
                        <option value="Junior Secondary (JSS)">Junior Secondary (JSS)</option>
                        <option value="Senior Secondary (SSS)">Senior Secondary (SSS)</option>
                    </select>
                </div>
                <div>
                    <label>Grant / Tech Prize</label>
                    <select name="award" required>
                        <option value="₦5,000,000 Cash Tuition Grant">₦5,000,000 Cash Tuition Grant</option>
                        <option value="₦300,000 Cash Tuition Grant">₦300,000 Cash Tuition Grant</option>
                        <option value="₦200,000 Cash Tuition Grant">₦200,000 Cash Tuition Grant</option>
                        <option value="Brand-New Student Laptop">Brand-New Student Laptop</option>
                        <option value="Educational Learning Tablet">Educational Learning Tablet</option>
                        <option value="Brand-New Smartphone">Brand-New Smartphone</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="btn-award">Publish Grant Recipient</button>
                </div>
            </form>

            <% if (winners.length > 0) { %>
                <table>
                    <thead>
                        <tr>
                            <th>Published Name</th>
                            <th>Full Name & Email</th>
                            <th>Category</th>
                            <th>Award Won</th>
                            <th>Claim Code</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% winners.forEach(w => { %>
                            <tr>
                                <td><strong><%= w.displayName %></strong> (<%= w.state %>)</td>
                                <td><%= w.fullName %><br><small style="color:#64748b;"><%= w.email %></small></td>
                                <td><span class="badge"><%= w.level %></span></td>
                                <td style="color:#059669; font-weight:bold;"><%= w.award %></td>
                                <td><code><%= w.claimCode %></code></td>
                                <td>
                                    <form action="/admin/remove-winner" method="POST" style="margin:0;">
                                        <input type="hidden" name="winnerId" value="<%= w.id %>">
                                        <button type="submit" class="btn-del">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>

        <div class="card">
            <h2 style="margin-top: 0; color: #1e293b;">Student Report Cards Master Ledger</h2>
            <% if (uploadedResults.length === 0) { %>
                <p style="text-align: center; color: #94a3b8; padding: 2rem 0;">No student report card documents have been uploaded yet.</p>
            <% } else { %>
                <table>
                    <thead>
                        <tr><th>Student Name</th><th>Email Address</th><th>Class Level</th><th>Academic Term</th><th>Action</th></tr>
                    </thead>
                    <tbody>
                        <% uploadedResults.forEach(row => { %>
                            <tr>
                                <td style="font-weight: 600;"><%= row.first_name %> <%= row.last_name %></td>
                                <td><%= row.email %></td>
                                <td><span class="badge"><%= row.academic_class.replace("_", " ") %></span></td>
                                <td><%= row.term_number %> Term</td>
                                <td><a href="/download/<%= row.file_name %>" target="_blank" class="download-btn">📄 View Document</a></td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            <% } %>
        </div>
    </div>
<div style="background:#fff;padding:1.25rem 1.5rem;border-radius:1rem;border:1px solid #cbd5e1;margin:1.5rem auto;max-width:1100px;display:flex;align-items:center;justify-content:space-between;flex-wrap:wrap;gap:0.75rem;">
    <div>
        <strong style="color:#1e3a8a;font-size:1rem;">🔍 Search Students & Report Cards</strong>
        <div style="color:#64748b;font-size:0.85rem;">Filter instantly by student name, email address, or class</div>
    </div>
    <input type="text" id="adminSearchInput" onkeyup="filterSchoolPortal()" placeholder="Type student name, email, or class..." style="flex:1;min-width:250px;max-width:420px;padding:0.7rem 1rem;border:2px solid #1e3a8a;border-radius:0.5rem;font-size:0.95rem;">
</div>
<script>
function filterSchoolPortal() {
    const q = document.getElementById("adminSearchInput").value.toLowerCase().trim();
    document.querySelectorAll("table tbody tr").forEach(row => {
        const text = row.innerText.toLowerCase();
        row.style.display = text.includes(q) ? "" : "none";
    });
}
</script>
<div style="background:#fff;padding:1.5rem;border-radius:1rem;border:1px solid #e2e8f0;margin:1.5rem auto;max-width:1100px;">
    <h2 style="margin-top:0;color:#1e3a8a;">👨‍🎓 Registered Students Roster (<%= typeof students !== 'undefined' ? students.length : 0 %>)</h2>
    <% if (typeof students !== 'undefined' && students.length > 0) { %>
        <table style="width:100%;border-collapse:collapse;font-size:0.92rem;">
            <thead>
                <tr style="background:#f1f5f9;text-align:left;">
                    <th style="padding:0.65rem;border-bottom:1px solid #cbd5e1;">Student Name</th>
                    <th style="padding:0.65rem;border-bottom:1px solid #cbd5e1;">Email</th>
                    <th style="padding:0.65rem;border-bottom:1px solid #cbd5e1;">School</th><th style="padding:0.65rem;border-bottom:1px solid #cbd5e1;">Subscription Status</th><th style="padding:0.65rem;border-bottom:1px solid #cbd5e1;">School Commission (₦2,500/Term)</th><th style="padding:0.65rem;border-bottom:1px solid #cbd5e1;">Reset Password</th>
                </tr>
            </thead>
            <tbody>
                <% students.forEach(st => { %>
                <tr>
                    <td style="padding:0.65rem;border-bottom:1px solid #e2e8f0;"><strong><%= st.first_name %> <%= st.last_name %></strong></td>
                    <td style="padding:0.65rem;border-bottom:1px solid #e2e8f0;"><%= st.email %></td>
                    <td style="padding:0.65rem;border-bottom:1px solid #e2e8f0;"><%= st.school_name || 'General' %></td><td style="padding:0.65rem;border-bottom:1px solid #e2e8f0;"><% if (Number(st.paid_count) > 0) { %><span style="background:#d1fae5;color:#065f46;padding:0.25rem 0.6rem;border-radius:0.4rem;font-weight:bold;font-size:0.8rem;">✓ <%= st.paid_count %> Term(s) Paid</span><% } else { %><span style="background:#f1f5f9;color:#64748b;padding:0.25rem 0.6rem;border-radius:0.4rem;font-size:0.8rem;">Registered (Unpaid)</span><% } %></td>
<td style="padding:0.65rem;border-bottom:1px solid #e2e8f0;">
    <% const _isPartner = (typeof partnerSchoolNames !== "undefined" && Array.isArray(partnerSchoolNames)) ? partnerSchoolNames.includes(String(st.school_name || "").trim().toLowerCase()) : (typeof isSuper !== "undefined" && !isSuper); const _paid = Number(st.paid_count || 0); const _settled = Number(st.settled_count || 0); const _pending = _paid - _settled; %>
    <% if (!_isPartner) { %><span style="color:#64748b;font-size:0.8rem;">Independent (No School Share)</span><% } else if (_paid === 0) { %>
        <span style="color:#94a3b8;font-size:0.82rem;">—</span>
    <% } else if (_pending <= 0) { %>
        <span style="background:#dcfce7;color:#15803d;padding:0.25rem 0.6rem;border-radius:0.4rem;font-weight:bold;font-size:0.8rem;display:inline-block;">✓ Settled (₦<%= (_settled * 2500).toLocaleString() %>)</span>
    <% } else { %>
        <div style="display:flex;flex-wrap:wrap;gap:0.35rem;align-items:center;">
            <span style="background:#fef3c7;color:#b45309;padding:0.25rem 0.55rem;border-radius:0.4rem;font-weight:bold;font-size:0.78rem;">⏳ Pending: ₦<%= (_pending * 2500).toLocaleString() %></span>
            <% if (_settled > 0) { %>
                <span style="background:#dcfce7;color:#15803d;padding:0.2rem 0.5rem;border-radius:0.4rem;font-size:0.75rem;font-weight:bold;">✓ ₦<%= (_settled * 2500).toLocaleString() %> Settled</span>
            <% } %>
            <% if (typeof isSuper !== 'undefined' && isSuper) { %>
                <form action="/admin/settle-student-commission" method="POST" style="margin:0;">
                    <input type="hidden" name="targetUserId" value="<%= st.id %>">
                    <button type="submit" style="background:#16a34a;color:#fff;border:none;padding:0.3rem 0.6rem;border-radius:0.35rem;font-size:0.76rem;font-weight:bold;cursor:pointer;">✓ Mark Settled</button>
                </form>
            <% } %>
        </div>
    <% } %>
</td>
<td style="padding:0.65rem;border-bottom:1px solid #e2e8f0;">
    <form action="/admin/reset-user-password" method="POST" style="display:flex;gap:0.35rem;align-items:center;margin:0;">
        <input type="hidden" name="targetUserId" value="<%= st.id %>">
        <input type="text" name="newPassword" placeholder="New pass" minlength="4" required style="width:95px;padding:0.35rem 0.5rem;border:1px solid #cbd5e1;border-radius:0.35rem;font-size:0.8rem;">
        <button type="submit" style="background:#1e3a8a;color:#fff;border:none;padding:0.38rem 0.6rem;border-radius:0.35rem;font-size:0.78rem;font-weight:bold;cursor:pointer;">Reset</button>
    </form>
</td>
</tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p style="color:#64748b;margin:0;">No students registered under this school yet.</p>
    <% } %>
</div>
<div style="background:#fff;padding:1.5rem;border-radius:1rem;border:1px solid #cbd5e1;margin:1.5rem auto;max-width:1100px;">
<% if (typeof isSuper !== 'undefined' && isSuper) { %>
    <h2 style="margin-top:0;color:#1e3a8a;">📩 Incoming Subscribed Student Reports from Schools</h2>
    <% if (typeof schoolReports !== 'undefined' && schoolReports.length > 0) { %>
        <% schoolReports.forEach(rep => { %>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;padding:1rem;border-radius:0.65rem;margin-bottom:0.75rem;">
                <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                    <strong style="color:#1e3a8a;"><%= rep.school_name %> (<%= rep.subscribed_count %> Subscribed Students)</strong>
                    <span style="font-size:0.82rem;color:#64748b;">Sent by <%= rep.sender_email %></span>
                </div>
                <p style="margin:0.45rem 0;font-size:0.9rem;"><strong>Verified Paid Students:</strong> <%= rep.student_names %></p>
                <% if (rep.note) { %><div style="font-size:0.85rem;color:#475569;"><em>Note: <%= rep.note %></em></div><% } %>
            </div>
        <% }) %>
    <% } else { %>
        <p style="color:#64748b;margin:0;">No school subscription reports submitted yet.</p>
    <% } %>
<% } else { %>
    <h2 style="margin-top:0;color:#1e3a8a;">📤 Submit Subscribed Students List to Head Office</h2>
    <p style="color:#64748b;font-size:0.9rem;margin-top:0;">Send your verified list of paid/subscribed students directly to the Super Admin office for partnership records and commission settlement.</p>
    <form action="/admin/submit-subscription-report" method="POST" style="display:flex;gap:0.75rem;flex-wrap:wrap;align-items:center;">
        <input type="text" name="note" placeholder="Optional note (e.g. First Term batch, school bank details or contact)" style="flex:1;min-width:240px;padding:0.7rem;border:1px solid #cbd5e1;border-radius:0.5rem;">
        <button type="submit" style="background:#10b981;color:#fff;border:none;padding:0.75rem 1.25rem;border-radius:0.5rem;font-weight:bold;cursor:pointer;">📨 Send Subscribed Students to Head Office</button>
        <a href="https://wa.me(<%= encodeURIComponent(schoolName || '') %>)%20just%20submitted%20our%20subscribed%20students%20report%20on%20the%20portal." target="_blank" style="background:#16a34a;color:#fff;padding:0.75rem 1.15rem;border-radius:0.5rem;font-weight:bold;text-decoration:none;font-size:0.9rem;">💬 Notify via WhatsApp</a>
    </form>
<% } %>
</div>
<% if (typeof isSuper !== 'undefined' && isSuper) { %>
<div style="background:#fff;padding:1.5rem;border-radius:1rem;border:1px solid #cbd5e1;margin:1.5rem auto;max-width:1100px;">
    <h2 style="margin-top:0;color:#1e3a8a;">📬 Contact Us Inquiries (<%= typeof contactMessages !== 'undefined' ? contactMessages.length : 0 %>)</h2>
    <% if (typeof contactMessages !== 'undefined' && contactMessages.length > 0) { %>
        <% contactMessages.forEach(m => { %>
            <div style="background:#f8fafc;border:1px solid #e2e8f0;padding:1rem;border-radius:0.65rem;margin-bottom:0.75rem;">
                <div style="display:flex;justify-content:space-between;flex-wrap:wrap;gap:0.5rem;">
                    <strong style="color:#1e3a8a;"><%= m.name %> — <%= m.phone %></strong>
                    <span style="background:#e0e7ff;color:#1e3a8a;padding:0.2rem 0.6rem;border-radius:0.35rem;font-size:0.8rem;font-weight:bold;"><%= m.topic %></span>
                </div>
                <p style="margin:0.5rem 0 0 0;color:#334155;font-size:0.92rem;"><%= m.message %></p>
            </div>
        <% }) %>
    <% } else { %>
        <p style="color:#64748b;margin:0;">No contact form messages yet.</p>
    <% } %>
</div>
<% } %>
</body>
</html>














