<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1.0"><title>Remember Your Classmates &amp; Alumni Lounge | Result Vault</title><style>body{font-family:Arial,sans-serif;background:#f8fafc;color:#1e293b;margin:0}.top{background:#1e3a8a;color:#fff;padding:1rem 1.5rem;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.5rem}.top a{color:#fde047;text-decoration:none;font-weight:bold}.wrap{max-width:1080px;margin:1.5rem auto;padding:0 1rem;display:grid;grid-template-columns:repeat(auto-fit,minmax(310px,1fr));gap:1.25rem}.card{background:#fff;border-radius:0.9rem;padding:1.35rem;border:1.5px solid #cbd5e1}.btn{background:#1e3a8a;color:#fff;border:none;padding:0.5rem 0.9rem;border-radius:0.45rem;font-weight:bold;cursor:pointer;font-size:0.85rem}.btn-green{background:#15803d;color:#fff}input,textarea{width:100%;padding:0.6rem;border:1px solid #cbd5e1;border-radius:0.45rem;box-sizing:border-box;font-family:inherit}.chat-box{max-height:290px;overflow-y:auto;background:#f1f5f9;padding:0.85rem;border-radius:0.6rem;margin-bottom:0.75rem;display:flex;flex-direction:column;gap:0.5rem}.bubble-me{align-self:flex-end;background:#1e3a8a;color:#fff;padding:0.55rem 0.85rem;border-radius:0.8rem;max-width:78%;font-size:0.9rem}.bubble-them{align-self:flex-start;background:#fff;border:1px solid #cbd5e1;color:#1e293b;padding:0.55rem 0.85rem;border-radius:0.8rem;max-width:78%;font-size:0.9rem}</style></head><body><div class="top"><div><strong>REMEMBER YOUR CLASSMATES &amp; ALUMNI LOUNGE</strong><br><small style="color:#bfdbfe;"><%= me.first_name %> <%= me.last_name %> - <%= me.school_name || "General" %></small></div><a href="/dashboard">Back to My Result Vault</a></div><div class="wrap"><div class="card"><h3 style="margin-top:0;color:#1e3a8a;">Find Your Schoolmates &amp; Alumni</h3><form action="/classmates" method="GET" style="display:flex;gap:0.45rem;margin-bottom:1rem;"><input type="text" name="q" value="<%= q %>" placeholder="Search name, school, or state..."><button type="submit" class="btn">Search</button></form><% if (incoming.length > 0) { %><div style="background:#fefce8;border:1px solid #fde047;padding:0.75rem;border-radius:0.6rem;margin-bottom:1rem;"><strong style="color:#854d0e;font-size:0.86rem;">Classmate Requests (<%= incoming.length %>)</strong><% incoming.forEach(reqItem => { %><div style="display:flex;justify-content:space-between;align-items:center;margin-top:0.5rem;gap:0.4rem;"><div style="font-size:0.85rem;"><strong><%= reqItem.first_name %> <%= reqItem.last_name %></strong><br><span style="color:#64748b;"><%= reqItem.school_name %></span></div><form action="/classmates/respond" method="POST" style="display:flex;gap:0.3rem;margin:0;"><input type="hidden" name="connId" value="<%= reqItem.conn_id %>"><button type="submit" name="action" value="accept" class="btn btn-green">Accept</button><button type="submit" name="action" value="block" class="btn" style="background:#dc2626;">Ignore</button></form></div><% }) %></div><% } %><div style="max-height:360px;overflow-y:auto;"><% peers.forEach(p => { const rel = conns.find(c => (c.sender_id === me.id && c.receiver_id === p.id) || (c.receiver_id === me.id && c.sender_id === p.id)); %><div style="display:flex;justify-content:space-between;align-items:center;padding:0.65rem 0;border-bottom:1px solid #e2e8f0;gap:0.5rem;"><div><strong style="font-size:0.92rem;"><%= p.first_name %> <%= p.last_name %></strong><div style="font-size:0.78rem;color:#64748b;"><%= p.school_name || "Student" %> - <%= p.state || "" %></div></div><% if (rel && rel.status === "accepted") { %><a href="/classmates?chat=<%= p.id %>" class="btn btn-green" style="text-decoration:none;">Chat</a><% } else if (rel && rel.status === "pending") { %><span style="font-size:0.78rem;color:#b45309;font-weight:bold;">Pending</span><% } else if (!rel) { %><form action="/classmates/connect" method="POST" style="margin:0;"><input type="hidden" name="targetId" value="<%= p.id %>"><button type="submit" class="btn">+ Connect</button></form><% } %></div><% }) %></div></div><div class="card"><h3 style="margin-top:0;color:#15803d;">Classmate Private Chat</h3><% if (friends.length > 0) { %><div style="display:flex;gap:0.4rem;flex-wrap:wrap;margin-bottom:0.85rem;"><% friends.forEach(f => { %><a href="/classmates?chat=<%= f.id %>" style="padding:0.35rem 0.7rem;border-radius:999px;font-size:0.82rem;font-weight:bold;text-decoration:none;<%= activeFriend && activeFriend.id === f.id ? "background:#15803d;color:#fff;" : "background:#e2e8f0;color:#1e293b;" %>"><%= f.first_name %> <%= f.last_name %></a><% }) %></div><% } %><% if (activeFriend) { %><div style="font-size:0.85rem;margin-bottom:0.5rem;color:#1e3a8a;">Chatting with <strong><%= activeFriend.first_name %> <%= activeFriend.last_name %></strong> (<%= activeFriend.school_name %>)</div><div class="chat-box" id="chatBox"><% if (messages.length === 0) { %><p style="color:#64748b;font-size:0.85rem;text-align:center;margin:auto;">Say hello to your classmate!</p><% } %><% messages.forEach(m => { %><div class="<%= m.sender_id === me.id ? "bubble-me" : "bubble-them" %>"><%= m.body %></div><% }) %></div><form action="/classmates/send" method="POST" style="display:flex;gap:0.45rem;"><input type="hidden" name="receiverId" value="<%= activeFriend.id %>"><input type="text" name="body" placeholder="Write a message..." required><button type="submit" class="btn btn-green">Send</button></form><% } else { %><div style="background:#f8fafc;border:1px dashed #94a3b8;padding:1.5rem;border-radius:0.65rem;text-align:center;color:#64748b;"><p style="margin:0 0 0.5rem 0;font-weight:bold;color:#1e3a8a;">Reconnect With Classmates</p><p style="margin:0;font-size:0.88rem;">Click + Connect next to any schoolmate on the left. Once accepted, select their name above to chat!</p></div><% } %></div><div class="card"><h3 style="margin-top:0;color:#1e3a8a;"><%= me.school_name || "School" %> Yearbook &amp; Memory Wall</h3><p style="font-size:0.84rem;color:#64748b;margin-top:0;">Leave a class memory, teacher tribute, or graduation note for your schoolmates.</p><form action="/classmates/memory" method="POST" style="margin-bottom:1rem;"><input type="text" name="classTag" placeholder="Class / Set (e.g. SSS 3 Science - Class of 2026)" required style="margin-bottom:0.45rem;"><textarea name="memoryText" rows="2" placeholder="Write a memorable school moment..." required style="margin-bottom:0.45rem;"></textarea><button type="submit" class="btn" style="width:100%;">Post to School Yearbook Wall</button></form><div style="max-height:280px;overflow-y:auto;"><% if (memories.length === 0) { %><p style="color:#64748b;font-size:0.85rem;">Be the first from <strong><%= me.school_name %></strong> to post a memory!</p><% } %><% memories.forEach(mem => { %><div style="background:#eff6ff;border-left:4px solid #1e3a8a;padding:0.7rem;border-radius:0.45rem;margin-bottom:0.6rem;"><div style="font-size:0.76rem;font-weight:bold;color:#1e3a8a;"><%= mem.author_name %> - <%= mem.class_tag %></div><p style="margin:0.3rem 0 0 0;font-size:0.88rem;color:#1e293b;"><%= mem.memory_text %></p></div><% }) %></div></div></div><script>var cb=document.getElementById("chatBox");if(cb)cb.scrollTop=cb.scrollHeight;</script></body></html>
