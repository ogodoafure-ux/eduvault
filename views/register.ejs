<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Register | Result Vault</title>
    <style>
        body { background-color: #f3f4f6; font-family: sans-serif; display: flex; justify-content: center; align-items: center; min-height: 100vh; margin: 0; }
        .card { background: white; padding: 2rem; border-radius: 1rem; box-shadow: 0 4px 6px rgba(0,0,0,0.1); width: 100%; max-width: 400px; }
        h2 { margin-top: 0; color: #1e3a8a; text-align: center; }
        label { display: block; margin-top: 1rem; font-size: 0.875rem; font-weight: bold; color: #374151; }
        input, select { width: 100%; padding: 0.65rem; margin-top: 0.35rem; border: 1px solid #d1d5db; border-radius: 0.5rem; box-sizing: border-box; font-size: 0.95rem; }
        button { width: 100%; background-color: #2563eb; color: white; border: none; padding: 0.75rem; margin-top: 1.5rem; border-radius: 0.5rem; font-weight: bold; cursor: pointer; font-size: 1rem; }
        button:hover { background-color: #1d4ed8; }
        .link { text-align: center; margin-top: 1rem; font-size: 0.875rem; }
    </style>
</head>
<body>
    <div class="card">
        <h2>Create Vault Account</h2>
        <form action="/register" method="POST">
            <label>Account Type</label>
            <select name="role" required>
                <option value="student">Student Account</option>
                <option value="registry">School Registry / Admin</option>
            </select>

            <label>First Name</label>
            <input type="text" name="firstName" required placeholder="e.g. Chidi">

            <label>Last Name</label>
            <input type="text" name="lastName" required placeholder="e.g. Okonkwo">

            <label>Email Address</label>
            <input type="email" name="email" required placeholder="name@example.com">

            <label>Password</label>
            <input type="password" name="password" required placeholder="Create password">

            <% if (typeof selectedSchool !== "undefined" && selectedSchool) { %><div style="background:#eff6ff;border:1px solid #93c5fd;color:#1e3a8a;padding:0.65rem 0.85rem;border-radius:0.5rem;margin-bottom:0.85rem;font-size:0.9rem;">🏫 <strong>Official School Portal:</strong> <%= selectedSchool %></div><% } %>
<div style="margin-bottom:1rem;"><label style="display:block;font-weight:bold;margin-bottom:0.35rem;">School Name</label><input type="text" name="schoolName" placeholder="e.g. Chude Girls Model School, Sapele" required style="width:100%;padding:0.75rem;border:1px solid #cbd5e1;border-radius:0.5rem;box-sizing:border-box;"></div>
<button type="submit">Register Account</button>
        </form>
        <div class="link">Already have an account? <a href="/login">Log In</a></div>
    </div>
</body>
</html>





