<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Result Vault | Dashboard</title>
    <style>
        body { background: #f8fafc; margin: 0; font-family: sans-serif; color: #1e293b; }
        .navbar { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 1.15rem; font-weight: 900; color: #1e3a8a; text-decoration: none; text-transform: uppercase; }
        .container { max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
        .card { background: #fff; padding: 1.75rem; border-radius: 1rem; border: 1px solid #e2e8f0; margin-bottom: 1.5rem; }
        .profile-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
        .avatar { width: 68px; height: 68px; border-radius: 50%; object-fit: cover; border: 3px solid #10b981; background: #e2e8f0; }
        .grant-box { background: linear-gradient(135deg, #1e3a8a, #1d4ed8); color: #fff; padding: 1.5rem; border-radius: 1rem; margin-bottom: 1.5rem; }
        .class-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1.25rem; }
        .class-card { border: 1px solid #cbd5e1; border-radius: 0.85rem; padding: 1.25rem; background: #fff; }
        .class-card h3 { margin: 0 0 1rem 0; color: #1e3a8a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; }
        .term-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.6rem; padding: 0.85rem; margin-bottom: 0.75rem; }
        .term-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-weight: bold; font-size: 0.9rem; }
        .badge-locked { background: #fee2e2; color: #991b1b; padding: 0.2rem 0.55rem; border-radius: 0.35rem; font-size: 0.75rem; }
        .badge-unlocked { background: #d1fae5; color: #065f46; padding: 0.2rem 0.55rem; border-radius: 0.35rem; font-size: 0.75rem; }
        .btn-pay { background: #ea580c; color: #fff; border: none; padding: 0.55rem 1rem; border-radius: 0.45rem; font-weight: bold; cursor: pointer; width: 100%; font-size: 0.85rem; }
        .btn-upload { background: #10b981; color: #fff; border: none; padding: 0.5rem 0.9rem; border-radius: 0.4rem; font-weight: bold; cursor: pointer; font-size: 0.8rem; margin-top: 0.4rem; }
        .view-link { display: inline-block; margin-top: 0.5rem; color: #2563eb; font-weight: bold; font-size: 0.85rem; text-decoration: none; }
    </style>
</head>
<body>
<div style="position:fixed;inset:0;pointer-events:none;z-index:9999;display:flex;align-items:center;justify-content:center;opacity:0.095;">
  <svg width="460" height="460" viewBox="0 0 320 320" xmlns="http://w3.org">
    <defs>
      <linearGradient id="goldCup" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="#f59e0b"/>
        <stop offset="50%" stop-color="#eab308"/>
        <stop offset="100%" stop-color="#b45309"/>
      </linearGradient>
    </defs>
    <!-- Left & Right Trophy Handles -->
    <path d="M85 65 C35 65 35 145 92 155" fill="none" stroke="url(#goldCup)" stroke-width="14" stroke-linecap="round"/>
    <path d="M235 65 C285 65 285 145 228 155" fill="none" stroke="url(#goldCup)" stroke-width="14" stroke-linecap="round"/>
    <!-- Main Cup Bowl -->
    <path d="M82 45 H238 L222 145 C215 185 182 205 160 205 C138 205 105 185 98 145 Z" fill="url(#goldCup)"/>
    <!-- Cup Rim & Stem -->
    <rect x="74" y="36" width="172" height="14" rx="7" fill="#d97706"/>
    <rect x="146" y="202" width="28" height="48" fill="url(#goldCup)"/>
    <ellipse cx="160" cy="248" rx="46" ry="10" fill="#d97706"/>
    <!-- Pedestal Base -->
    <rect x="95" y="255" width="130" height="36" rx="8" fill="#1e3a8a"/>
    <text x="160" y="278" font-family="Arial,sans-serif" font-size="14" font-weight="900" fill="#fde047" text-anchor="middle">₦5,000,000 WINNER</text>
    <!-- Star Emblem on Cup -->
    <polygon points="160,72 171,102 203,102 177,120 187,150 160,132 133,150 143,120 117,102 149,102" fill="#ffffff" fill-opacity="0.85"/>
  </svg>
</div>
    <nav class="navbar">
        <a href="/" class="logo">Nigeria Pry & Sec <span>Result Vault</span></a>
        <div>
            <span style="margin-right:1rem;font-size:0.9rem;">Hi, <strong><%= user ? user.firstName : 'Student' %></strong></span>
            <a href="/logout" style="color:#ef4444;font-weight:bold;text-decoration:none;font-size:0.85rem;">Log Out</a>
        </div>
    </nav>
    <div class="container">
        <div class="card profile-bar">
            <div style="display:flex;align-items:center;gap:1rem;">
                <img src="<%= (user && user.profilePicUrl) ? user.profilePicUrl : '/download/hero-students.png' %>" alt="Student Photo" class="avatar">
                <div>
                    <h3 style="margin:0 0 0.25rem 0;"><%= user ? (user.firstName + ' ' + user.lastName) : 'Student Account' %></h3>
                    <div style="font-size:0.85rem;color:#64748b;"><%= user ? user.email : '' %></div>
                </div>
            </div>
            <form action="/upload-profile-pic" method="POST" enctype="multipart/form-data" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                <input type="file" name="avatarFile" accept="image/*" required style="font-size:0.8rem;">
                <button type="submit" class="btn-upload" style="margin-top:0;background:#2563eb;">📷 Update Photo</button>
            </form>
        </div>
        <div class="grant-box">
            <div style="font-weight:900;color:#fde68a;font-size:0.85rem;text-transform:uppercase;margin-bottom:0.35rem;">🎓 Annual Academic Grant & Tech Award (August 14, 2027)</div>
            <p style="margin:0;font-size:0.95rem;line-height:1.5;">Every verified vault subscription automatically qualifies your child for ₦200,000–₦5,000,000 cash grants and digital learning devices across Primary, Junior, and Senior Secondary levels!</p>
        </div>
        <div class="card">
            <h2 style="margin-top:0;">Your Academic Vaults</h2>
            <div class="class-grid">
                <% Array.of("PRIMARY_1","PRIMARY_2","PRIMARY_3","PRIMARY_4","PRIMARY_5","PRIMARY_6","JSS_1","JSS_2","JSS_3","SSS_1","SSS_2","SSS_3").forEach(cid => { %>
                <div class="class-card">
                    <h3><%= cid.replace("_", " ") %> Vault</h3>
                    <% Array.of(1, 2, 3).forEach(t => { const key = cid + "_TERM_" + t; const isUnlocked = Array.isArray(unlockedClasses) && unlockedClasses.includes(key); %>
                    <div class="term-box">
                        <div class="term-header">
                            <span><%= t === 1 ? '1st' : (t === 2 ? '2nd' : '3rd') %> Term</span>
                            <% if (isUnlocked) { %><span class="badge-unlocked">✓ Unlocked</span><% } else { %><span class="badge-locked">🔒 Locked</span><% } %>
                        </div>
                        <% if (isUnlocked) { %>
                            <form action="/upload-result" method="POST" enctype="multipart/form-data">
                                <input type="hidden" name="classId" value="<%= cid %>">
                                <input type="hidden" name="term" value="<%= t %>">
                                <input type="file" name="resultDoc" accept=".pdf,.jpg,.jpeg,.png" required style="font-size:0.8rem;width:100%;">
                                <button type="submit" class="btn-upload">📤 Upload Report Card</button>
                            </form>
                            <% if (savedResults && savedResults[key]) { %><a href="<%= savedResults[key].startsWith("http") ? savedResults[key] : ("/download/" + savedResults[key]) %>" target="_blank" class="view-link">📄 View Saved Result</a><% } %>
                        <% } else { %>
                            <form action="/paystack/initialize" method="POST" style="margin:0;">
                                <input type="hidden" name="classId" value="<%= cid %>">
                                <input type="hidden" name="termNumber" value="<%= t %>">
                                <button type="submit" class="btn-pay">💳 Pay ₦6,000 to Unlock</button>
                            </form>
                        <% } %>
                    </div>
                    <% }) %>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
</body>
</html>




