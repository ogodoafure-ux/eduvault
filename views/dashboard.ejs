<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Result Vault | Dashboard</title>
    <style>
        body { background: #f8fafc; margin: 0; font-family: sans-serif; color: #1e293b; }
        .navbar { background: #fff; border-bottom: 1px solid #e2e8f0; padding: 1rem 2rem; display: flex; justify-content: space-between; align-items: center; }
        .logo { font-size: 1.15rem; font-weight: 900; color: #1e3a8a; text-decoration: none; text-transform: uppercase; }
        .container { max-width: 1100px; margin: 2rem auto; padding: 0 1rem; }
        .card { background: #fff; padding: 1.75rem; border-radius: 1rem; border: 1px solid #e2e8f0; margin-bottom: 1.5rem; }
        .profile-bar { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem; }
        .avatar { width: 68px; height: 68px; border-radius: 50%; object-fit: cover; border: 3px solid #10b981; background: #e2e8f0; }
        .grant-box { background: linear-gradient(135deg, #1e3a8a, #1d4ed8); color: #fff; padding: 1.5rem; border-radius: 1rem; margin-bottom: 1.5rem; }
        .class-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); gap: 1.25rem; }
        .class-card { border: 1px solid #cbd5e1; border-radius: 0.85rem; padding: 1.25rem; background: #fff; }
        .class-card h3 { margin: 0 0 1rem 0; color: #1e3a8a; border-bottom: 1px solid #e2e8f0; padding-bottom: 0.5rem; }
        .term-box { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 0.6rem; padding: 0.85rem; margin-bottom: 0.75rem; }
        .term-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem; font-weight: bold; font-size: 0.9rem; }
        .badge-locked { background: #fee2e2; color: #991b1b; padding: 0.2rem 0.55rem; border-radius: 0.35rem; font-size: 0.75rem; }
        .badge-unlocked { background: #d1fae5; color: #065f46; padding: 0.2rem 0.55rem; border-radius: 0.35rem; font-size: 0.75rem; }
        .btn-pay { background: #ea580c; color: #fff; border: none; padding: 0.55rem 1rem; border-radius: 0.45rem; font-weight: bold; cursor: pointer; width: 100%; font-size: 0.85rem; }
        .btn-upload { background: #10b981; color: #fff; border: none; padding: 0.5rem 0.9rem; border-radius: 0.4rem; font-weight: bold; cursor: pointer; font-size: 0.8rem; margin-top: 0.4rem; }
        .view-link { display: inline-block; margin-top: 0.5rem; color: #2563eb; font-weight: bold; font-size: 0.85rem; text-decoration: none; }
    </style>
<link rel="icon" type="image/svg+xml" href="data:image/svg+xml;utf8,%3Csvg xmlns='http://w3.org' viewBox='0 0 64 64'%3E%3Cpath d='M32 4 L56 13 V31 C56 46 45 55 32 60 C19 55 8 46 8 31 V13 Z' fill='%231e3a8a' stroke='%23eab308' stroke-width='3'/%3E%3Cpolygon points='32,17 48,24 32,31 16,24' fill='%23ffffff'/%3E%3Cpath d='M21 37 Q26.5 34 32 37.5 Q37.5 34 43 37 V46 Q37.5 43 32 46.5 Q26.5 43 21 46 Z' fill='%23eab308'/%3E%3C/svg%3E">
</head>
<body>
<%
  const _resKeys = (typeof savedResults !== 'undefined' && savedResults) ? Object.keys(savedResults) : [];
  const _totalResults = _resKeys.length;
  const _byClass = {};
  _resKeys.forEach(k => {
    const parts = k.split('_');
    const cls = parts[0] || 'GENERAL';
    const trm = String(parts[1] || '').trim();
    if (!_byClass[cls]) _byClass[cls] = new Set();
    _byClass[cls].add(trm);
  });
  let _hasThree = false;
  let _hasTwoValid = false;
  Object.values(_byClass).forEach(set => {
    if (set.has('1') && set.has('2') && set.has('3')) _hasThree = true;
    if ((set.has('1') && set.has('2')) || (set.has('2') && set.has('3'))) _hasTwoValid = true;
  });
%>
<div style="max-width:1100px;margin:1.25rem auto;padding:1.15rem 1.4rem;border-radius:0.9rem;border:2px solid <%= _hasThree ? '#10b981' : (_hasTwoValid ? '#3b82f6' : '#f59e0b') %>;background:<%= _hasThree ? '#ecfdf5' : (_hasTwoValid ? '#eff6ff' : '#fffbeb') %>;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:0.85rem;">
  <div>
    <div style="font-weight:900;font-size:1rem;color:#1e3a8a;">
      <% if (_hasThree) { %>
        🏆 Maximum Grant Entries Active (<%= _totalResults %> Result Sheets in Winner Box!)
      <% } else if (_hasTwoValid) { %>
        ✅ Qualified for the ₦200,000 – ₦5,000,000 Annual Grant! (<%= _totalResults %> Terms Uploaded)
      <% } else { %>
        ⏳ Grant Qualification Progress: <%= _totalResults %> Term Uploaded (Need 2 Terms to Qualify)
      <% } %>
    </div>
    <div style="font-size:0.88rem;color:#334155;margin-top:0.25rem;">
      <% if (_hasThree) { %>
        All <strong>3 term result sheets (1st, 2nd &amp; 3rd Term)</strong> are inside the selection box for maximum winning chances—and stored permanently in your vault for life!
      <% } else if (_hasTwoValid) { %>
        You meet the <strong>2-term qualification</strong>! Upload your remaining term so <strong>all 3 result sheets</strong> enter the winner box for even higher chances.
      <% } else { %>
        Upload at least <strong>two (2) term results</strong> for the session (<strong>1st &amp; 2nd Term</strong> or <strong>2nd &amp; 3rd Term</strong>) to qualify—or upload <strong>all 3 terms</strong> for maximum chances. All files stay saved <strong>for life</strong>!
      <% } %>
    </div>
  </div>
  <span style="background:#1e3a8a;color:#fde047;padding:0.45rem 0.9rem;border-radius:999px;font-weight:bold;font-size:0.82rem;white-space:nowrap;">
    🔒 Lifetime Cloud Storage Active
  </span>
</div>
<div style="position:fixed;inset:0;pointer-events:none;z-index:9999;display:flex;align-items:center;justify-content:center;opacity:0.065;">
  <svg width="430" height="430" viewBox="0 0 320 320" xmlns="http://w3.org">
    <!-- Outer Academic Shield -->
    <path d="M160 28 L268 68 V152 C268 222 216 268 160 292 C104 268 52 222 52 152 V68 Z" fill="#1e3a8a" stroke="#0f172a" stroke-width="6"/>
    <path d="M160 44 L252 78 V150 C252 210 207 250 160 272 C113 250 68 210 68 150 V78 Z" fill="none" stroke="#eab308" stroke-width="4"/>
    <!-- Graduation Cap -->
    <polygon points="160,82 226,112 160,142 94,112" fill="#ffffff"/>
    <path d="M122 126 V152 C122 164 198 164 198 152 V126" fill="none" stroke="#ffffff" stroke-width="6"/>
    <line x1="226" y1="112" x2="226" y2="154" stroke="#eab308" stroke-width="5" stroke-linecap="round"/>
    <!-- Open Book & Verification Check -->
    <path d="M108 184 Q134 174 160 186 Q186 174 212 184 V218 Q186 208 160 220 Q134 208 108 218 Z" fill="#ffffff" fill-opacity="0.9"/>
    <path d="M144 236 L156 248 L180 224" fill="none" stroke="#10b981" stroke-width="8" stroke-linecap="round" stroke-linejoin="round"/>
  </svg>
</div>
<nav class="navbar">
        <a href="/" class="logo">Nigeria Pry & Sec <span>Result Vault</span></a>
        <div>
            <span style="margin-right:1rem;font-size:0.9rem;">Hi, <strong><%= user ? user.firstName : 'Student' %></strong></span>
            <a href="/logout" style="color:#ef4444;font-weight:bold;text-decoration:none;font-size:0.85rem;">Log Out</a>
        </div>
    </nav>
    <div class="container">
        <div class="card profile-bar">
            <div style="display:flex;align-items:center;gap:1rem;">
                <img src="<%= (user && user.profilePicUrl) ? user.profilePicUrl : '/download/hero-students.png' %>" alt="Student Photo" class="avatar">
                <div>
                    <h3 style="margin:0 0 0.25rem 0;"><%= user ? (user.firstName + ' ' + user.lastName) : 'Student Account' %></h3>
                    <div style="font-size:0.85rem;color:#64748b;"><%= user ? user.email : '' %></div>
                </div>
            </div>
            <form action="/upload-profile-pic" method="POST" enctype="multipart/form-data" style="display:flex;align-items:center;gap:0.5rem;flex-wrap:wrap;">
                <input type="file" name="avatarFile" accept="image/*" required style="font-size:0.8rem;">
                <button type="submit" class="btn-upload" style="margin-top:0;background:#2563eb;">📷 Update Photo</button>
            </form>
        </div>
        <div class="grant-box">
            <div style="font-weight:900;color:#fde68a;font-size:0.85rem;text-transform:uppercase;margin-bottom:0.35rem;">🎓 Annual Academic Grant & Tech Award (August 14, 2027)</div>
            <p style="margin:0;font-size:0.95rem;line-height:1.5;">Every verified vault subscription automatically qualifies your child for ₦200,000–₦5,000,000 cash grants and digital learning devices across Primary, Junior, and Senior Secondary levels!</p>
        </div>
        <div class="card">
            <h2 style="margin-top:0;">Your Academic Vaults</h2>
            <div class="class-grid">
                <% Array.of("PRIMARY_1","PRIMARY_2","PRIMARY_3","PRIMARY_4","PRIMARY_5","PRIMARY_6","JSS_1","JSS_2","JSS_3","SSS_1","SSS_2","SSS_3").forEach(cid => { %>
                <div class="class-card">
                    <h3><%= cid.replace("_", " ") %> Vault</h3>
                    <% Array.of(1, 2, 3).forEach(t => { const key = cid + "_TERM_" + t; const isUnlocked = Array.isArray(unlockedClasses) && unlockedClasses.includes(key); %>
                    <div class="term-box">
                        <div class="term-header">
                            <span><%= t === 1 ? '1st' : (t === 2 ? '2nd' : '3rd') %> Term</span>
                            <% if (isUnlocked) { %><span class="badge-unlocked">✓ Unlocked</span><% } else { %><span class="badge-locked">🔒 Locked</span><% } %>
                        </div>
                        <% if (isUnlocked) { %>
                            <form action="/upload-result" method="POST" enctype="multipart/form-data">
                                <input type="hidden" name="classId" value="<%= cid %>">
                                <input type="hidden" name="term" value="<%= t %>">
                                <input type="file" name="resultDoc" accept=".pdf,.jpg,.jpeg,.png" required style="font-size:0.8rem;width:100%;">
                                <button type="submit" class="btn-upload">📤 Upload Report Card</button>
                            </form>
                            <% if (savedResults && savedResults[key]) { %><a href="<%= savedResults[key].startsWith("http") ? savedResults[key] : ("/download/" + savedResults[key]) %>" target="_blank" class="view-link">📄 View Saved Result</a><% } %>
                        <% } else { %>
                            <form action="/paystack/initialize" method="POST" style="margin:0;">
                                <input type="hidden" name="classId" value="<%= cid %>">
                                <input type="hidden" name="termNumber" value="<%= t %>">
                                <button type="submit" class="btn-pay">💳 Pay ₦6,000 to Unlock</button>
                            </form>
                        <% } %>
                    </div>
                    <% }) %>
                </div>
                <% }) %>
            </div>
        </div>
    </div>
<div style="max-width:820px;margin:1.5rem auto;background:#fefce8;border:2px solid #eab308;border-radius:0.85rem;padding:1.25rem;text-align:center;"><strong style="color:#1e3a8a;font-size:1.05rem;">🎓 Are You in SSS 1, SSS 2, or SSS 3? Become a Student Ambassador!</strong><p style="margin:0.4rem 0 0.85rem;color:#334155;font-size:0.92rem;">Share your referral link with classmates and earn <strong>₦1,000</strong> (or <strong>₦500</strong> for partner schoolmates) every time they unlock a term vault!</p><a href="/refer" style="display:inline-block;background:#1e3a8a;color:#fde047;padding:0.65rem 1.2rem;border-radius:0.45rem;font-weight:bold;text-decoration:none;">Get My SSS 1–3 Referral Link →</a></div><div style="max-width:820px;margin:1rem auto;background:#eff6ff;border:2px solid #1e3a8a;border-radius:0.85rem;padding:1.2rem;text-align:center;"><strong style="color:#1e3a8a;font-size:1.05rem;">Remember Your Classmates &amp; Alumni Lounge</strong><p style="margin:0.35rem 0 0.8rem;color:#334155;font-size:0.9rem;">Reconnect with your Primary &amp; Secondary schoolmates, post on your School Yearbook Memory Wall, and chat privately!</p><a href="/classmates" style="display:inline-block;background:#1e3a8a;color:#fde047;padding:0.65rem 1.25rem;border-radius:0.45rem;font-weight:bold;text-decoration:none;">Open Classmate Lounge &amp; Chat</a></div></body>
</html>










