</div>
<nav class="navbar">
        <a href="/" class="logo">Nigeria Pry & Sec Result Vault</a>
        <div>
            <a href="/" style="margin-right:1rem;color:#1e3a8a;text-decoration:none;font-weight:bold;">Home</a>
            <a href="/login" style="color:#1e3a8a;text-decoration:none;font-weight:bold;">Log In</a>
        </div>
    </nav>
    <div class="container">
        <h1 style="color:#1e3a8a;margin-bottom:0.35rem;">Contact Support & Nationwide Offices</h1>
        <p style="color:#64748b;margin-top:0;margin-bottom:1.75rem;">Reach our support desk or visit any of our offices in Abuja, Lagos, and Sapele, Delta State.</p>
        <div class="grid">
            <div class="card">
                <h3 style="margin-top:0;color:#1e3a8a;">💬 Phone, Email & WhatsApp</h3>
                <p style="margin:0.3rem 0;"><strong>Phone / WhatsApp:</strong> <a href="tel:+2348105752678" style="color:#1e3a8a;text-decoration:none;">+234 810 575 2678</a></p>
                <p style="margin:0.3rem 0;"><strong>Email:</strong> <a href="mailto:info@nigeriapryandsecresultvaultcom.com" style="color:#1e3a8a;word-break:break-all;">info@nigeriapryandsecresultvaultcom.com</a></p>
                <a href="https://wa.me" target="_blank" class="btn-wa">Chat on WhatsApp</a>
                <a href="https://whatsapp.com" target="_blank" class="btn-blue">Join WhatsApp Group</a>
            </div>
            <div class="card">
                <h3 style="margin-top:0;color:#1e3a8a;">🏛️ Head Office (Abuja)</h3>
                <p style="margin:0.3rem 0;line-height:1.5;">Plot 1229, Ladoke Akintola Boulevard, Garki II, Abuja.</p>
                <h3 style="margin:1rem 0 0.3rem 0;color:#1e3a8a;">🏢 Lagos Branch Office</h3>
                <p style="margin:0;line-height:1.5;">2nd Floor, 52-54 Isaac John St, Ikeja GRA, Lagos 101233, Lagos.</p>
            </div>
            <div class="card">
                <h3 style="margin-top:0;color:#1e3a8a;">🏢 Sapele Branch Office (Delta State)</h3>
                <p style="margin:0.3rem 0;line-height:1.5;">24 Amuogodo, Sapele-Warri Road, Sapele, Delta State.</p>
                <p style="margin:0.75rem 0 0 0;color:#64748b;font-size:0.88rem;">Office Hours: Mon – Sat, 8:00 AM – 6:00 PM (WAT)</p>
            </div>
        </div>
        <div class="card">
            <h3 style="margin-top:0;color:#1e3a8a;">Send Us a Direct Inquiry</h3>
            <% if (typeof sent !== 'undefined' && sent) { %>
                <div style="background:#d1fae5;color:#065f46;padding:1rem;border-radius:0.5rem;margin-bottom:1rem;font-weight:bold;">✓ Message received! Our team will follow up with you shortly.</div>
            <% } %>
            <form action="/contact" method="POST">
                <label>Full Name</label><input type="text" name="name" placeholder="e.g. Mr. Oghenekevwe Ojo" required>
                <label>Phone / WhatsApp Number</label><input type="text" name="phone" placeholder="e.g. 0810 575 2678" required>
                <label>Inquiry Type</label>
                <select name="topic"><option>Parent / Student Vault Support</option><option>School Partnership & Registry Onboarding</option><option>₦200,000 – ₦5,000,000 Grant Inquiry</option></select>
                <label>Message</label><textarea name="message" rows="4" placeholder="How can we assist you?" required></textarea>
                <button type="submit" class="btn-submit">Send Message</button>
            </form>
        </div>
    </div>
